# Line endings & text normalization
* text=auto

# Unreal / C++ source
*.cpp text diff=cpp
*.h text diff=cpp
*.cs text
*.ini text
*.uproject text
*.Build.cs text
*.Target.cs text
*.md text
*.json text
*.xml text
*.bat text eol=crlf
*.sh text eol=lf

# Wwise project files (XML text — diff/merge friendly)
*.wwu text
*.wproj text

# Git LFS — binary & large assets
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.bnk filter=lfs diff=lfs merge=lfs -text
*.wem filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ufbx filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text

# Common binary textures (when not embedded in .uasset)
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.exr binary
