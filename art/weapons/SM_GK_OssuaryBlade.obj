# SM_GK_OssuaryBlade.obj
# Ashen Ossuary — hero arming sword, production base mesh
# Units: centimetres. Pivot: grip centre. Blade direction: +X.
# Total length ≈ 138 cm  (pommel tip X=-44 to blade tip X=94)
#
# Vertex summary (161 total)
#   v1   – v50  : blade  (6 edge-loops × 8 + tip + base cap)
#   v51  – v92  : crossguard (3 sections/arm × 8 + 2 tips)
#   v93  – v116 : grip (3 octagonal loops × 8)
#   v117 – v132 : grip bands (2 raised bands × 2 rings × 4)
#   v133 – v161 : pommel (collar 4+4, body 8+8, near-tip 4, tip 1)
#
# Material slots — assign PBR Material Instances in Unreal:
#   M_GK_Blade_DarkSteel   blade flat faces  (oxidised black iron)
#   M_GK_Blade_BrightEdge  cutting edges     (worn bright metal)
#   M_GK_Guard_Iron        crossguard iron   (hammered dark iron)
#   M_GK_Guard_Bone        bone inlay panels (aged ivory)
#   M_GK_Grip_Leather      grip wrap         (dried dark leather)
#   M_GK_Grip_Band         wrap bands        (bone/iron rings)
#   M_GK_Pommel_Iron       iron collar       (polished dark iron)
#   M_GK_Pommel_Bone       pommel cap        (carved ossuary bone)
#
# UV NOTE: No explicit UV coordinates — import with Auto Generate UV
# in Unreal, or do a UV unwrap pass in Blender/Maya before texturing.
#
mtllib SM_GK_OssuaryBlade.mtl
o SM_GK_OssuaryBlade

