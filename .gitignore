# Created by https://www.toptal.com/developers/gitignore/api/unrealengine
# Edit at https://www.toptal.com/developers/gitignore?templates=unrealengine

### UnrealEngine ###
# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

### UnrealEngine Patch ###
# Don't ignore icon and splash images for mobile app
!Build/IOS/Resources/
Build/IOS/Resources/*
!Build/IOS/Resources/Graphics/
Build/IOS/Resources/Graphics/*
!Build/IOS/Resources/Graphics/*.png
!Build/Android/res/
Build/Android/res/*
!Build/Android/res/*/
Build/Android/res/*/*
!Build/Android/res/*/*.png
# Ignore plugins binaries on deep subfolders
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# End of https://www.toptal.com/developers/gitignore/api/unrealengine

### Ashen Ossuary — Project Additions ###

# OS / shell
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & local agent state (.cursorrules at repo root stays tracked)
.idea/
.vscode/
.cursor/

# Visual Studio / MSBuild artifacts (generated locally)
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.tlog
*.pdb
*.ipch

# Xcode (not primary target; ignore if generated)
*.xcodeproj
*.xcworkspace

# Compiled libraries & executables
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.mod

# Logs & crash dumps
*.log
*.dmp

# User-specific Unreal Editor settings
Config/*UserSettings.ini
Config/DefaultEditorPerProjectUserSettings.ini

# Wwise user / machine / cache files (safety net; see GK_WwiseProject/.gitignore)
*.wsettings
*.validationcache
*.akd
.backup*
.cache/

# Local packaging output
Releases/
Packaged/
*.pak

# Non-Windows platform Engine configs (Windows-only project)
# UE/Wwise auto-regenerates these on editor open — keep ignored, not tracked
Config/Android/AndroidEngine.ini
Config/IOS/IOSEngine.ini
Config/Linux/LinuxEngine.ini
Config/LinuxArm64/
Config/Mac/MacEngine.ini
Config/TVOS/
Config/VisionOS/
